<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="/top_favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/style.css">
    <title>Messageboard project</title>
  </head>
  <body>
    <h1 class="title"><%= title %></h1>
    
    <% messages.forEach((message) => { %>
      <div class="messageDiv">
        <p class="user"><%= message.user %></p>
        <p class="text"><%= message.text %></p>
        <p class="date"><%= message.added %></p>
        <a href="/messageDetails/<%= message.id %>" class="details">Open message details</a>
      </div>
    <% }) %>

    <a href="/new">Create a new message</a>
  </body>
</html>
